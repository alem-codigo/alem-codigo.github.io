---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import imagemPadrao from '../assets/og/padrao.png';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { verificarIntegridade } from '../lib/integridade';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  /** Título da página; a home usa só o nome do programa. */
  title?: string;
  description?: string;
  /**
   * Imagem da prévia dos links (Open Graph): na página da mentoria, a capa. Sem ela, a imagem
   * padrão com a logo (src/assets/og/padrao.png). Recortada para 1200×630 no build.
   */
  imagem?: ImageMetadata;
  /** Texto alternativo da imagem da prévia. */
  imagemAlt?: string;
  /** Página que nunca deve ser indexada nem ter canônica (ex.: 404). */
  semIndice?: boolean;
}

const { title, description = SITE.descricao, imagem, imagemAlt, semIndice = false } = Astro.props;
const tituloCompleto = title ? `${title} · ${SITE.nome}` : SITE.nome;
const canonica = semIndice ? null : new URL(Astro.url.pathname, Astro.site).toString();

// Prévia no WhatsApp, LinkedIn e Facebook: 1200×630 (1,91:1) em JPEG, que todos aceitam
// (WebP e AVIF ainda falham em alguns). `fit: cover` recorta o centro da capa.
const og = await getImage({
  src: imagem ?? imagemPadrao,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
const ogImagem = new URL(og.src, Astro.site).toString();
const ogImagemAlt = imagemAlt ?? `${SITE.nome}: mentorias em tecnologia`;
const robots = semIndice || !SITE.indexar ? 'noindex, nofollow' : 'index, follow';

// Toda página usa este layout: referência quebrada no conteúdo falha o build.
await verificarIntegridade();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0e0c15" />
    <!--
      Aplica o tema salvo antes da pintura (padrão: escuro) e marca que há JavaScript,
      para o botão de tema aparecer. Precisa ficar inline e no início do <head>.
    -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        try {
          if (localStorage.getItem('tema') === 'claro') {
            r.dataset.tema = 'claro';
            document.querySelector('meta[name="theme-color"]').setAttribute('content', '#e9eaf0');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="description" content={description} />
    <!-- noindex até o lançamento (SITE.indexar, Fase 3) e sempre em páginas como a 404. -->
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content={SITE.verificacaoGoogle} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonica && <link rel="canonical" href={canonica} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Open Graph e Twitter Cards: prévia dos links compartilhados (D-21). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title ?? SITE.nome} />
    <meta property="og:description" content={description} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImagemAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.nome} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagem} />
    <meta name="twitter:image:alt" content={ogImagemAlt} />
    <Font cssVariable="--fonte-texto" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--fonte-mono" />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Luz que acompanha o mouse (.card--brilho e áreas com [data-luz], como a capa da home):
      // só posiciona --mx/--my; o efeito é todo em CSS.
      // Um único listener para a página inteira; só onde há mouse.
      if (matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const card = e.target instanceof Element ? e.target.closest<HTMLElement>('.card--brilho, [data-luz]') : null;
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
