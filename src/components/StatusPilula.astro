---
/** Pílula do status. Mentoria encerrada não tem pílula: o componente não renderiza nada. */
import { ROTULO_STATUS, temPilula, type StatusMentoria } from '../lib/status';

interface Props {
  status: StatusMentoria;
}

const { status } = Astro.props;
---

{temPilula(status) && <span class="pilula" data-status={status}>{ROTULO_STATUS[status]}</span>}
