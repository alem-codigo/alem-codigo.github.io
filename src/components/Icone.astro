---
/** Ícone de marca ou de link (src/lib/icones.ts). Decorativo: o texto acessível fica no elemento pai. */
import { ICONES_MARCA, type NomeIcone } from '../lib/icones';

interface Props {
  nome: NomeIcone;
  class?: string;
}

const { nome, class: classe } = Astro.props;
const icone = ICONES_MARCA[nome];
---

<svg class:list={['icone-marca', classe]} aria-hidden="true" viewBox={icone.viewBox}>
  <path d={icone.d} />
</svg>

<style>
  .icone-marca {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .icone-marca path {
    fill: currentColor;
  }
</style>
