---
/**
 * Logo em SVG inline, para animar no hover/foco do link que a contém: a estrada se forma
 * do fim até a bandeira e, ao chegar, a bandeira tremula. Use só uma vez por página (o
 * cabeçalho): o SVG tem ids próprios (`adc-*`). Nos outros lugares, use <Logo />.
 *
 * As cores vêm dos tokens `--logo-*` (trocam sozinhas no tema escuro). Sem animação em
 * telas sem hover e com `prefers-reduced-motion: reduce`.
 */
import svg from '../assets/marca/logo-animado.svg?raw';

interface Props {
  /** Altura em px; a largura segue a proporção do desenho. */
  altura?: number;
}

const { altura = 40 } = Astro.props;
---

<span class="logo-animado" style={`--logo-altura: ${altura}px`} set:html={svg} />

<style>
  .logo-animado {
    display: inline-block;
    line-height: 0;
  }

  .logo-animado :global(.logo-animado__svg) {
    height: var(--logo-altura);
    width: auto;
    overflow: visible;
  }

  .logo-animado :global(.lg-texto) {
    fill: var(--logo-texto);
    stroke: var(--logo-texto);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .logo-animado :global(.lg-codigo),
  .logo-animado :global(.lg-detalhe) {
    fill: var(--logo-azul);
  }

  .logo-animado :global(.lg-bandeira) {
    fill: var(--logo-bandeira);
    /* Origem no mastro, meio da bandeira (coordenadas do viewBox). */
    transform-box: view-box;
    transform-origin: 42px 134px;
  }

  .logo-animado :global(.lg-estrada),
  .logo-animado :global(.lg-mastro) {
    fill: var(--logo-estrada);
    stroke: var(--logo-estrada);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  /* Traços da máscara que revela a estrada: pathLength = 1, desenhados por completo. */
  .logo-animado :global(.lg-traco) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo-animado :global(.lg-traco),
    :global(a:focus-visible) > .logo-animado :global(.lg-traco) {
      animation: logo-estrada 900ms cubic-bezier(0.45, 0, 0.2, 1) both;
    }

    :global(a:hover) > .logo-animado :global(.lg-bandeira),
    :global(a:focus-visible) > .logo-animado :global(.lg-bandeira) {
      animation: logo-tremular 1100ms ease-in-out 750ms both;
    }
  }

  /* Do fim da estrada até a bandeira (offset negativo revela a partir do fim do traço). */
  @keyframes logo-estrada {
    from {
      stroke-dashoffset: -1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes logo-tremular {
    0%,
    100% {
      transform: none;
    }
    18% {
      transform: skewY(-5deg) scaleX(0.9);
    }
    38% {
      transform: skewY(4deg) scaleX(1.02);
    }
    58% {
      transform: skewY(-3deg) scaleX(0.94);
    }
    78% {
      transform: skewY(1.5deg) scaleX(1);
    }
  }
</style>
