---
/**
 * Logo como <img> de SVG externo: arquivos em cache para todas as páginas, sem ids
 * duplicados no HTML. A versão `auto` acompanha o tema do site (escuro por padrão, claro com
 * <html data-tema="claro">): renderiza as duas versões coloridas e o CSS mostra a certa.
 */
interface Props {
  variante?: 'auto' | 'grafite' | 'branca';
  /** Altura em px; a largura segue a proporção do desenho. */
  altura?: number;
  /** Vazio quando a logo está dentro de um link que já tem nome acessível. */
  alt?: string;
  class?: string;
}

const PROPORCAO = 344.8 / 131;
const MONO = {
  grafite: '/marca/logo-grafite.svg',
  branca: '/marca/logo-branca.svg',
} as const;

const { variante = 'auto', altura = 44, alt = 'Além do Código', class: classe } = Astro.props;
const largura = Math.round(altura * PROPORCAO);
---

{
  variante === 'auto' ? (
    <>
      <img
        src="/marca/logo-colorida-escura.svg"
        width={largura}
        height={altura}
        alt={alt}
        class:list={[classe, 'logo--escura']}
        decoding="async"
      />
      <img
        src="/marca/logo-colorida-clara.svg"
        width={largura}
        height={altura}
        alt={alt}
        class:list={[classe, 'logo--clara']}
        decoding="async"
      />
    </>
  ) : (
    <img src={MONO[variante]} width={largura} height={altura} alt={alt} class={classe} decoding="async" />
  )
}

<style>
  .logo--clara {
    display: none;
  }

  :global(:root[data-tema='claro']) .logo--clara {
    display: block;
  }

  :global(:root[data-tema='claro']) .logo--escura {
    display: none;
  }
</style>
