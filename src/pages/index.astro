---
import { getCollection } from 'astro:content';
import ComoFunciona from '../components/ComoFunciona.astro';
import Hero from '../components/Hero.astro';
import MentoriaCard from '../components/MentoriaCard.astro';
import SecaoEixos from '../components/SecaoEixos.astro';
import Base from '../layouts/Base.astro';
import { hojeEmSaoPaulo } from '../lib/datas';
import { destaquesHome } from '../lib/mentorias';
import { inscricoesAbertas } from '../lib/status';

const hoje = hojeEmSaoPaulo();
const mentorias = await getCollection('mentorias');
// Uma seção só, "Conheça as mentorias": até 3 cards (abertas, depois em breve e em andamento).
const destaques = destaquesHome(
  mentorias.map((entrada) => ({ ...entrada.data, entrada })),
  hoje,
);

// Com inscrições abertas, os botões da capa e da chamada final levam à seção da própria home.
const linkInscricoes = mentorias.some((m) => inscricoesAbertas(m.data, hoje)) ? '#mentorias' : null;
---

<Base>
  <Hero linkInscricoes={linkInscricoes} />

  <section class="secao container pilha mentorias" id="mentorias" aria-labelledby="mentorias-titulo">
    <header class="secao-cabecalho">
      <div class="secao-cabecalho__texto">
        <p class="rotulo">Mentorias</p>
        <h2 id="mentorias-titulo">Conheça as mentorias</h2>
        <p class="texto-suave">Turmas com inscrições abertas, as próximas e as que estão em andamento.</p>
      </div>
    </header>

    {
      destaques.length > 0 ? (
        <ul class="grade mentorias__lista" role="list">
          {destaques.map(({ mentoria, status }) => (
            <li>
              <MentoriaCard mentoria={mentoria.entrada} status={status} hoje={hoje} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="mentorias__vazio">
          <p class="mentorias__vazio-titulo">Nenhuma turma aberta ou em andamento no momento</p>
          <p class="texto-suave">
            Novas turmas abrem ao longo do semestre. Enquanto isso, conheça as mentorias anteriores e os eixos de
            formação.
          </p>
        </div>
      )
    }

    <p><a class="link-seta" href="/mentorias">Veja todas as mentorias</a></p>
  </section>

  <ComoFunciona />
  <SecaoEixos />

  <section class="secao container" aria-labelledby="chamada-titulo">
    <div class="card card--brilho chamada" data-variante="violeta">
      <h2 id="chamada-titulo">Pronto para ir além do código?</h2>
      <p class="texto-suave">Veja as turmas abertas, confira a elegibilidade e garanta sua vaga.</p>
      <div class="grupo">
        {
          linkInscricoes ? (
            <a class="botao" href={linkInscricoes}>
              Ver inscrições abertas
            </a>
          ) : (
            <a class="botao" href="/mentorias">
              Conhecer as mentorias
            </a>
          )
        }
        <a class="botao botao--contorno" href="/como-participar">Como participar</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .mentorias {
    --pilha-espaco: var(--espaco-l);
  }

  /* Lado a lado, no máximo 3 por linha. */
  .mentorias__lista {
    --grade-min: max(18rem, calc((100% - 2 * var(--espaco-m)) / 3));
  }

  .mentorias__vazio-titulo {
    font-size: var(--passo-1);
    font-weight: var(--peso-negrito);
  }

  .mentorias__lista > li {
    display: grid;
  }

  .mentorias__vazio {
    display: grid;
    gap: var(--espaco-2xs);
    padding: var(--espaco-l);
    border: 1px dashed var(--cor-borda);
    border-radius: var(--raio-l);
  }

  .chamada {
    align-items: flex-start;
    gap: var(--espaco-s);
    padding: var(--espaco-xl) var(--espaco-l);
  }

  .chamada .botao {
    align-self: auto;
  }
</style>
