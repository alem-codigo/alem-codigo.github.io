---
/**
 * Página do eixo (/eixos/curriculo-e-trabalhabilidade): ícone, número, título e descrição; as
 * mentorias ativas do eixo em cards (mesma ordem da home) e as anteriores no mosaico que rola
 * (GaleriaEncerradas). Embaixo, links para o eixo anterior e o próximo.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import GaleriaEncerradas from '../../components/GaleriaEncerradas.astro';
import MentoriaCard from '../../components/MentoriaCard.astro';
import Base from '../../layouts/Base.astro';
import { hojeEmSaoPaulo } from '../../lib/datas';
import { caminhoEixo, ICONES_EIXO } from '../../lib/eixos';
import { listagemMentorias, slugParceiro } from '../../lib/mentorias';
import { NEWSLETTER } from '../../lib/site';

export const getStaticPaths = (async () => {
  const eixos = (await getCollection('eixos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return eixos.map((eixo, i) => ({
    params: { slug: eixo.id },
    props: { eixo, anterior: eixos[i - 1] ?? null, proximo: eixos[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { eixo, anterior, proximo } = Astro.props;
const e = eixo.data;
const hoje = hojeEmSaoPaulo();
const mentorias = (await getCollection('mentorias')).filter((m) => m.data.eixos.some((r) => r.id === eixo.id));
const { ativas, encerradas } = listagemMentorias(
  mentorias.map((entrada) => ({ ...entrada.data, entrada })),
  hoje,
);
---

<Base title={`Eixo ${e.numero}: ${e.titulo}`} description={e.descricao}>
  <div class="container eixo-pagina">
    <nav class="trilha" aria-label="Trilha">
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <a href="/eixos/">Eixos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{e.titulo}</span>
    </nav>

    <header class="eixo-pagina__cabecalho">
      <span class="icone eixo-pagina__icone">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d={ICONES_EIXO[e.icone].d} /></svg>
      </span>
      <div class="eixo-pagina__texto">
        <p class="eixo-pagina__numero mono">Eixo {e.numero}</p>
        <h1>{e.titulo}</h1>
        <p class="texto-suave eixo-pagina__descricao">{e.descricao}</p>
      </div>
    </header>

    <section class="pilha eixo-pagina__secao" aria-labelledby="ativas-titulo">
      <h2 class="eixo-pagina__titulo-secao" id="ativas-titulo">Mentorias deste eixo</h2>
      {
        ativas.length > 0 ? (
          <ul class="grade eixo-pagina__grade" role="list">
            {ativas.map(({ mentoria, status }) => (
              <li>
                <MentoriaCard mentoria={mentoria.entrada} status={status} hoje={hoje} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="eixo-pagina__vazio">
            <p class="eixo-pagina__vazio-titulo">Nenhuma turma deste eixo com inscrições abertas ou em andamento.</p>
            <p class="texto-suave">
              Veja <a href="/mentorias/">todas as mentorias</a> ou <a href={NEWSLETTER}>assine a newsletter</a> para saber
              quando abrir uma nova turma.
            </p>
          </div>
        )
      }
    </section>
  </div>

  {
    encerradas.length > 0 && (
      <section class="encerradas" aria-labelledby="encerradas-titulo">
        <GaleriaEncerradas
          rotuloId="encerradas-titulo"
          itens={encerradas.map(({ mentoria }) => ({
            entrada: mentoria.entrada,
            eixos: mentoria.eixos.map((r) => r.id).join(' '),
            parceria: mentoria.parceiro ? slugParceiro(mentoria.parceiro.nome) : '',
          }))}
        >
          <Fragment slot="cabecalho">
            <p class="rotulo">Já realizadas</p>
            <h2 class="eixo-pagina__titulo-secao" id="encerradas-titulo">
              Mentorias anteriores
            </h2>
          </Fragment>
        </GaleriaEncerradas>
      </section>
    )
  }

  <nav class="container eixo-pagina__vizinhos" aria-label="Outros eixos">
    {
      anterior ? (
        <a class="eixo-pagina__vizinho" href={caminhoEixo(anterior.id)}>
          <span class="eixo-pagina__vizinho-rotulo">← Eixo {anterior.data.numero}</span>
          <span>{anterior.data.titulo}</span>
        </a>
      ) : (
        <span />
      )
    }
    <a class="eixo-pagina__todos link-seta" href="/eixos/">
      Todos os eixos
    </a>
    {
      proximo ? (
        <a class="eixo-pagina__vizinho eixo-pagina__vizinho--proximo" href={caminhoEixo(proximo.id)}>
          <span class="eixo-pagina__vizinho-rotulo">Eixo {proximo.data.numero} →</span>
          <span>{proximo.data.titulo}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<style>
  .eixo-pagina {
    display: grid;
    gap: var(--espaco-xl);
    padding-block: var(--espaco-l) var(--espaco-2xl);
  }

  .trilha {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2xs);
    color: var(--cor-texto-suave);
    font-size: var(--passo--1);
  }

  .eixo-pagina__cabecalho {
    display: flex;
    align-items: flex-start;
    gap: var(--espaco-m);
  }

  .eixo-pagina__icone {
    width: 4rem;
    height: 4rem;
    border-radius: var(--raio-l);
  }

  .eixo-pagina__icone svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .eixo-pagina__texto {
    display: grid;
    gap: var(--espaco-2xs);
  }

  .eixo-pagina__numero {
    color: var(--icone-cor);
    font-weight: 700;
  }

  .eixo-pagina__descricao {
    font-size: var(--passo-1);
  }

  .eixo-pagina__secao {
    --pilha-espaco: var(--espaco-m);
  }

  .eixo-pagina__titulo-secao {
    font-size: var(--passo-2);
  }

  .eixo-pagina__grade {
    --grade-min: max(18rem, calc((100% - 2 * var(--espaco-m)) / 3));
  }

  .eixo-pagina__grade > li {
    display: grid;
  }

  .eixo-pagina__vazio {
    display: grid;
    gap: var(--espaco-2xs);
    padding: var(--espaco-l);
    border: 1px dashed var(--cor-borda);
    border-radius: var(--raio-l);
  }

  .eixo-pagina__vazio-titulo {
    font-size: var(--passo-1);
    font-weight: var(--peso-negrito);
  }

  /* Anteriores: faixa de ponta a ponta, como na listagem de mentorias. */
  .encerradas {
    padding-block: var(--espaco-xl) var(--espaco-2xl);
    border-block-start: var(--borda);
    background: var(--cor-faixa);
  }

  /* ---- Eixo anterior / todos / próximo ---- */
  .eixo-pagina__vizinhos {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--espaco-s);
    padding-block: var(--espaco-xl);
  }

  .eixo-pagina__vizinho {
    display: grid;
    gap: 0.15rem;
    padding: var(--espaco-xs) var(--espaco-s);
    border: var(--borda);
    border-radius: var(--raio-m);
    color: var(--cor-texto);
    font-weight: var(--peso-negrito);
    text-decoration: none;
  }

  .eixo-pagina__vizinho:hover {
    border-color: var(--cor-link);
  }

  .eixo-pagina__vizinho--proximo {
    text-align: end;
  }

  .eixo-pagina__vizinho-rotulo {
    color: var(--icone-cor);
    font-family: var(--fonte-mono);
    font-size: var(--passo--1);
  }

  @media (width < 48rem) {
    .eixo-pagina__cabecalho {
      flex-direction: column;
    }

    .eixo-pagina__vizinhos {
      grid-template-columns: 1fr 1fr;
    }

    .eixo-pagina__todos {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
  }
</style>
