---
/**
 * Mentores (/mentores): duas seções, mentores fixos (equipe do programa) e convidados, cada uma em
 * ordem alfabética. Cada card mostra o perfil (MentorPerfil); as mentorias do mentor ficam
 * recolhidas e abrem ao clicar no card (ou no botão "Mentorias", pelo teclado).
 *
 * Sem JavaScript, o botão "Mentorias" (<details>) continua abrindo e fechando a lista.
 */
import { getCollection } from 'astro:content';
import MentorPerfil from '../../components/MentorPerfil.astro';
import StatusPilula from '../../components/StatusPilula.astro';
import Base from '../../layouts/Base.astro';
import { hojeEmSaoPaulo } from '../../lib/datas';
import { caminhoMentoria, listagemMentorias, periodoCurto } from '../../lib/mentorias';

const hoje = hojeEmSaoPaulo();
const [mentores, mentorias] = await Promise.all([getCollection('mentores'), getCollection('mentorias')]);
const ordenados = mentores.sort((a, b) => a.data.nome.localeCompare(b.data.nome, 'pt-BR'));

const mentoriasDe = (id: string) => {
  const doMentor = mentorias.filter((m) => m.data.mentores.some((r) => r.id === id));
  const { ativas, encerradas } = listagemMentorias(
    doMentor.map((entrada) => ({ ...entrada.data, entrada })),
    hoje,
  );
  return [...ativas, ...encerradas];
};

const SECOES = [
  {
    id: 'fixos',
    titulo: 'Mentores fixos',
    texto: 'A equipe que mantém o programa, planeja as mentorias e acompanha as turmas.',
    lista: ordenados.filter((m) => m.data.tipo === 'fixo'),
  },
  {
    id: 'convidados',
    titulo: 'Mentores convidados',
    texto: 'Profissionais e professores convidados para conduzir mentorias específicas.',
    lista: ordenados.filter((m) => m.data.tipo === 'convidado'),
  },
].filter((s) => s.lista.length > 0);
---

<Base
  title="Mentores"
  description="Conheça os mentores do Além do Código: a equipe fixa do programa e os mentores convidados."
>
  <div class="container mentores-pagina">
    <header class="secao-cabecalho">
      <div class="secao-cabecalho__texto">
        <p class="rotulo">Mentores</p>
        <h1>Quem conduz as mentorias</h1>
        <p class="texto-suave">Professores e profissionais que acompanham cada turma, do primeiro encontro ao projeto final.</p>
      </div>
    </header>

    {
      SECOES.map((secao) => (
        <section class="mentores-pagina__secao" aria-labelledby={`secao-${secao.id}`}>
          <div class="mentores-pagina__cabecalho">
            <h2 id={`secao-${secao.id}`}>{secao.titulo}</h2>
            <p class="texto-suave">{secao.texto}</p>
          </div>
          <ul class="mentores-pagina__lista" role="list">
            {secao.lista.map((mentor) => {
              const lista = mentoriasDe(mentor.id);
              return (
                <li class="card mentor-card" data-expansivel={lista.length > 0 ? '' : undefined}>
                  <MentorPerfil mentor={mentor} nivel="h3" foto="grande" />
                  {lista.length > 0 && (
                    <details class="mentor-card__mentorias">
                      <summary>
                        <span>
                          {lista.length > 1 ? 'Mentorias' : 'Mentoria'} ({lista.length})
                        </span>
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </summary>
                      <ul role="list">
                        {lista.map(({ mentoria, status }) => (
                          <li>
                            <a href={caminhoMentoria(mentoria.entrada.id)}>{mentoria.titulo}</a>
                            <span class="mentor-card__meta">
                              {periodoCurto(mentoria.realizacao.inicio, mentoria.realizacao.fim)}
                            </span>
                            <StatusPilula status={status} />
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  // O card inteiro abre e fecha a lista de mentorias; cliques em links e no próprio botão seguem normais.
  for (const card of document.querySelectorAll<HTMLElement>('[data-expansivel]')) {
    const detalhes = card.querySelector<HTMLDetailsElement>('details')!;
    card.addEventListener('click', (e) => {
      const alvo = e.target as Element;
      if (alvo.closest('a, button, summary, details[open] ul')) return;
      detalhes.open = !detalhes.open;
    });
  }
</script>

<style>
  .mentores-pagina {
    display: grid;
    gap: var(--espaco-xl);
    padding-block: var(--espaco-xl) var(--espaco-2xl);
  }

  .mentores-pagina__secao {
    display: grid;
    gap: var(--espaco-m);
  }

  .mentores-pagina__cabecalho {
    display: grid;
    gap: var(--espaco-3xs);
  }

  .mentores-pagina__cabecalho h2 {
    font-size: var(--passo-2);
  }

  .mentores-pagina__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    align-items: start;
    gap: var(--espaco-m);
  }

  .mentor-card {
    padding: var(--espaco-m);
  }

  .mentor-card[data-expansivel] {
    cursor: pointer;
  }

  .mentor-card[data-expansivel]:hover {
    border-color: color-mix(in srgb, var(--mentor-destaque) 55%, var(--_borda));
  }

  /* ---- Mentorias do mentor (recolhidas) ---- */
  .mentor-card__mentorias {
    margin-block-start: var(--espaco-xs);
    border-block-start: 1px solid var(--_borda);
  }

  .mentor-card__mentorias summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-xs);
    min-height: 2.75rem;
    padding-block-start: var(--espaco-xs);
    color: var(--_texto-suave);
    font-family: var(--fonte-mono);
    font-size: var(--passo--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .mentor-card__mentorias summary::-webkit-details-marker {
    display: none;
  }

  .mentor-card__mentorias summary svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--mentor-destaque);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--duracao) var(--curva);
  }

  .mentor-card__mentorias[open] summary svg {
    rotate: 180deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .mentor-card__mentorias summary svg {
      transition: none;
    }
  }

  .mentor-card__mentorias ul {
    display: grid;
    gap: var(--espaco-2xs);
    padding-block: var(--espaco-2xs) var(--espaco-3xs);
    cursor: auto;
  }

  .mentor-card__mentorias li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-3xs) var(--espaco-xs);
    max-width: none;
  }

  .mentor-card__mentorias a {
    font-weight: var(--peso-negrito);
  }

  .mentor-card__meta {
    color: var(--_texto-suave);
    font-size: var(--passo--1);
  }
</style>
