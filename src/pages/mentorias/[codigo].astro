---
/**
 * Página da mentoria (/mentorias/m26-01). Gerada para toda mentoria cadastrada: o card da home só
 * existe junto com esta página. Informações em blocos (estilo "bento" do Railway): capa e título;
 * card de inscrição à direita (no celular, no fim); mentores, eixos, parceiro, público e objetivo.
 * Inscrição: botão do Forms nas inscrições abertas; data de abertura em "em breve"; campo "me avise"
 * nos demais status (D-19); "Adicionar ao calendário" conforme o status.
 * Portal da turma (D-34): com a turma do Classroom ligada (`classroomCourseId`), a partir das
 * inscrições encerradas, o card de inscrição ganha "Acessar a turma". A página pública não mostra
 * nada da turma; depois do login com a conta Google do aluno, o conteúdo (lives, prazos e
 * cronograma) é buscado no Classroom e aparece logo depois da capa (opção B).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import AcessoTurma from '../../components/AcessoTurma.astro';
import AdicionarCalendario from '../../components/AdicionarCalendario.astro';
import LogoParceiro from '../../components/LogoParceiro.astro';
import AvisoTurma from '../../components/AvisoTurma.astro';
import Compartilhar from '../../components/Compartilhar.astro';
import Estrelas from '../../components/Estrelas.astro';
import MentorPerfil from '../../components/MentorPerfil.astro';
import PortalTurma from '../../components/PortalTurma.astro';
import StatusPilula from '../../components/StatusPilula.astro';
import Base from '../../layouts/Base.astro';
import { linkDaTurma, mostrarPortal } from '../../lib/classroom';
import { hojeEmSaoPaulo } from '../../lib/datas';
import { ICONES_EIXO } from '../../lib/eixos';
import { eventoCalendario } from '../../lib/calendario';
import {
  avaliacaoPublicavel,
  caminhoMentoria,
  dataDestaque,
  formatarInteiro,
  formatarNota,
  formatarPeriodo,
  juntarLista,
} from '../../lib/mentorias';
import { calcularStatus, ROTULO_STATUS, VARIANTE_CARD } from '../../lib/status';

export const getStaticPaths = (async () => {
  const mentorias = await getCollection('mentorias');
  return mentorias.map((mentoria) => {
    // Seção 6.2: o objetivo (corpo do arquivo) é obrigatório na página.
    if (!mentoria.body?.trim()) {
      throw new Error(`Mentoria "${mentoria.id}" sem objetivo: preencha o campo Objetivo no painel.`);
    }
    return { params: { codigo: mentoria.id }, props: { mentoria } };
  });
}) satisfies GetStaticPaths;

const { mentoria } = Astro.props;
const m = mentoria.data;
const hoje = hojeEmSaoPaulo();
const status = calcularStatus(m, hoje);
const variante = VARIANTE_CARD[status];
const { Content } = await render(mentoria);
const [eixos, mentores, selos, cursos] = await Promise.all([
  getEntries(m.eixos),
  getEntries(m.mentores),
  getEntries(m.selos),
  getEntries(m.cursos),
]);
const textoCursos = cursos.some((c) => c.id === 'todos')
  ? 'Todos os cursos do Cluster de TI'
  : juntarLista(cursos.map((c) => `${c.data.nome} (${c.data.sigla})`));
const eixosOrdenados = eixos.sort((a, b) => a.data.ordem - b.data.ordem);
const periodoInscricoes = formatarPeriodo(m.inscricoes.abertura, m.inscricoes.fechamento, hoje);
const periodoRealizacao = formatarPeriodo(m.realizacao.inicio, m.realizacao.fim, hoje);
const abertura = dataDestaque(m.inscricoes.abertura);
const fechamento = dataDestaque(m.inscricoes.fechamento);
const urlPagina = new URL(caminhoMentoria(mentoria.id), Astro.site).toString();
const evento = eventoCalendario(m, status, mentoria.id, urlPagina);
const turma = m.classroomCourseId && mostrarPortal(status) ? { courseId: m.classroomCourseId, link: linkDaTurma(m.classroomCourseId) } : undefined;

// Resultado da turma: só depois que ela começa (antes disso, os números ainda mudam).
const r = status === 'em-andamento' || status === 'encerrada' ? m.resultado : undefined;
const nota = avaliacaoPublicavel(r);
type NumeroTurma = { rotulo: string; valor: string; detalhe?: string; estrelas?: number };
const numerosTurma: NumeroTurma[] = ([
  r?.inscritos !== undefined && { rotulo: 'Inscritos', valor: formatarInteiro(r.inscritos) },
  r?.concluintes !== undefined && { rotulo: 'Concluintes', valor: formatarInteiro(r.concluintes) },
  nota && {
    rotulo: 'Avaliação dos alunos',
    valor: `${formatarNota(nota.media)} de 5`,
    detalhe: `${formatarInteiro(nota.respostas)} avaliações`,
    estrelas: nota.media,
  },
] as (NumeroTurma | false)[]).filter((n): n is NumeroTurma => Boolean(n));
const depoimentos = r?.depoimentos ?? [];
---

<Base
  title={m.titulo}
  description={m.resumo}
  imagem={m.capa}
  imagemAlt={m.capa ? `Capa da mentoria ${m.titulo}` : undefined}
>
  <article class="container mentoria-pagina bento-pagina">
    <nav class="mentoria-pagina__trilha" aria-label="Trilha">
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <a href="/mentorias/">Mentorias</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{m.titulo}</span>
    </nav>

    <div class="bento" data-sem-parceiro={m.parceiro ? undefined : ''}>
      <header class="card bento__bloco bento__capa">
    <div class="mentoria-pagina__banner">
      {
        m.capa ? (
          <Image class="mentoria-pagina__capa" src={m.capa} alt="" widths={[720, 1200, 1600]} sizes="(min-width: 72rem) 72rem, 100vw" loading="eager" />
        ) : (
          <div class="mentoria-pagina__capa capa-padrao" />
        )
      }
    </div>
        <div class="bento__capa-texto">
        <div class="mentoria-pagina__topo">
          <div class="mentoria-pagina__pilulas">
            <StatusPilula status={status} />
            {selos.map((s) => <span class="selo">{s.data.nome}</span>)}
          </div>
          <Compartilhar url={urlPagina} titulo={m.titulo} />
        </div>
          <h1>{m.titulo}</h1>
          <p class="mentoria-pagina__resumo">{m.resumo}</p>
        </div>
      </header>

      <aside class="bento__inscricao" aria-label="Inscrição">
        <div class="card mentoria-pagina__inscricao" data-variante={variante === 'padrao' ? undefined : variante}>
          <StatusPilula status={status} />
          {/* A encerrada não tem pílula (D-17); o status aparece como texto. */}
          {status === 'encerrada' && <p class="mentoria-pagina__encerrada">Mentoria encerrada</p>}
          <dl class="mentoria-pagina__datas">
            <div>
              <dt>Inscrições</dt>
              <dd>{periodoInscricoes}</dd>
            </div>
            <div>
              <dt>Realização</dt>
              <dd>{periodoRealizacao}</dd>
            </div>
          </dl>

          {turma && <AcessoTurma linkTurma={turma.link} />}

          {
            status === 'inscricoes-abertas' && (
              <>
                <a class="botao mentoria-pagina__inscrever" href={m.formUrl}>
                  Inscrever-se
                  <span class="visualmente-oculto">(formulário do Google)</span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
                <p class="mentoria-pagina__nota">
                  Inscrições até {fechamento.extenso}. Use o e-mail da sua conta Google: o convite da turma chega nele.
                </p>
              </>
            )
          }
          {
            status === 'em-breve' && (
              <p class="mentoria-pagina__nota mentoria-pagina__nota--destaque">Inscrições abrem em {abertura.extenso}.</p>
            )
          }
          {
            (status === 'inscricoes-encerradas' || status === 'em-andamento' || status === 'encerrada') && (
              <AvisoTurma mentoria={`${m.codigo} · ${m.titulo}`} situacao={ROTULO_STATUS[status]} />
            )
          }
          {evento && <AdicionarCalendario evento={evento} ics={`/mentorias/${mentoria.id}.ics`} arquivo={`${mentoria.id}.ics`} />}
        </div>
      </aside>

      {turma && <PortalTurma courseId={turma.courseId} linkTurma={turma.link} />}

      <div class="card bento__bloco bento__objetivo">
        <section aria-labelledby="objetivo">
          <h2 id="objetivo">Objetivo</h2>
          <div class="prosa"><Content /></div>
        </section>
        {
          m.necessidade && (
            <section class="bento__necessidade" aria-labelledby="necessidade">
              <h2 id="necessidade">Necessidade de mercado</h2>
              <p class="prosa">{m.necessidade}</p>
            </section>
          )
        }
      </div>

      <div class="card bento__bloco bento__eixos">
        <h2 class="bento__rotulo">Eixos</h2>
        <ul class="mentoria-pagina__eixos" role="list" aria-label="Eixos">
          {
            eixosOrdenados.map((e) => (
              <li>
                <details class="eixo-dica" name="eixos-da-mentoria">
                  <summary class="mentoria-pagina__eixo">
                    <span class="icone">
                      <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d={ICONES_EIXO[e.data.icone].d} />
                      </svg>
                    </span>
                    <span class="eixo-dica__nome">
                      <span class="mentoria-pagina__eixo-numero mono">Eixo {e.data.numero}</span>
                      {e.data.titulo}
                    </span>
                  </summary>
                  <p class="eixo-dica__balao" aria-hidden="true">
                    Eixo {e.data.numero} · {e.data.titulo}
                  </p>
                </details>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card bento__bloco bento__publico">
        <section aria-labelledby="para-quem">
          <h2 id="para-quem">Para quem é</h2>
          <dl class="mentoria-pagina__lista">
            <div>
              <dt>Cursos elegíveis</dt>
              <dd>{textoCursos}</dd>
            </div>
            {
              m.prerequisitos.length > 0 && (
                <div>
                  <dt>Pré-requisitos</dt>
                  <dd>
                    <ul>
                      {m.prerequisitos.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
        </section>
      </div>

      <div class="card bento__bloco bento__mentores">
        <section aria-labelledby="mentores">
          <h2 id="mentores">{mentores.length > 1 ? 'Mentores' : 'Mentoria com'}</h2>
          <ul class="mentoria-pagina__mentores" role="list">
            {
              mentores.map((p) => (
                <li>
                  <MentorPerfil mentor={p} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      {
        m.parceiro && (
          <section class="card bento__bloco bento__parceiro" aria-labelledby="parceiro">
            <h2 id="parceiro">Em parceria com</h2>
            <a href={m.parceiro.url}>
              <LogoParceiro logo={m.parceiro.logo} logoEscura={m.parceiro.logoEscura} alt={m.parceiro.nome} altura={96} />
            </a>
          </section>
        )
      }
    </div>

    {
      (numerosTurma.length > 0 || depoimentos.length > 0) && (
        <section class="card turma" aria-labelledby="turma-titulo">
          <h2 class="turma__titulo" id="turma-titulo">
            {status === 'encerrada' ? 'Como foi a turma' : 'A turma'}
          </h2>
          {numerosTurma.length > 0 && (
            <dl class="turma__numeros">
              {numerosTurma.map((n) => (
                <div class="turma__numero">
                  <dt>{n.rotulo}</dt>
                  <dd>
                    {n.estrelas !== undefined && <Estrelas media={n.estrelas} id={`estrelas-${mentoria.id}`} />}
                    <span class="turma__valor">{n.valor}</span>
                    {n.detalhe && <span class="turma__detalhe">{n.detalhe}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          {depoimentos.length > 0 && (
            <ul class="turma__depoimentos" role="list" aria-label="Depoimentos dos alunos">
              {depoimentos.map((d) => (
                <li>
                  <figure class="depoimento">
                    <blockquote>
                      <p>{d.texto}</p>
                    </blockquote>
                    <figcaption>{d.autor}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }
  </article>
</Base>


<style>
  .mentoria-pagina {
    display: grid;
    gap: var(--espaco-m);
    padding-block: var(--espaco-l) var(--espaco-2xl);
  }

  .mentoria-pagina__trilha {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2xs);
    color: var(--cor-texto-suave);
    font-size: var(--passo--1);
  }

  /* ---- Banner: faixa larga (21:9), mais baixa no celular ---- */
  .mentoria-pagina__banner {
    overflow: hidden;
    aspect-ratio: 21 / 9;
    border: var(--borda);
    border-radius: var(--raio-l);
  }

  .mentoria-pagina__capa {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width < 48rem) {
    .mentoria-pagina__banner {
      aspect-ratio: 16 / 9;
    }
  }

  .mentoria-pagina__pilulas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3xs);
  }

  .mentoria-pagina h1 {
    font-size: var(--passo-4);
  }

  .mentoria-pagina__resumo {
    color: var(--cor-texto-suave);
    font-size: var(--passo-1);
  }

  .mentoria-pagina__eixos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-xs) var(--espaco-m);
  }

  /* Ícone alinhado ao topo do texto (número do eixo + título, que pode quebrar em duas linhas). */
  .mentoria-pagina__eixo {
    display: flex;
    align-items: flex-start;
    gap: var(--espaco-2xs);
    font-weight: var(--peso-negrito);
  }

  .eixo-dica__nome {
    display: grid;
    line-height: 1.25;
  }

  /* No desktop o nome já está visível: o <summary> não abre nada. */
  .mentoria-pagina__eixo {
    list-style: none;
    cursor: default;
  }

  .mentoria-pagina__eixo::-webkit-details-marker {
    display: none;
  }

  .eixo-dica__balao {
    display: none;
  }

  @media (width < 48rem) {
    .mentoria-pagina__eixos {
      gap: var(--espaco-2xs);
    }

    .mentoria-pagina__eixos li {
      position: relative;
    }

    .eixo-dica__nome {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .mentoria-pagina__eixo {
      cursor: pointer;
      border-radius: var(--raio-m);
    }

    .mentoria-pagina__eixo .icone {
      width: 2.75rem; /* alvo de toque de 44px */
      height: 2.75rem;
    }

    .eixo-dica[open] .icone {
      box-shadow: inset 0 0 0 2px var(--icone-cor);
    }

    .eixo-dica[open] .eixo-dica__balao {
      position: absolute;
      z-index: 3;
      top: calc(100% + 0.4rem);
      left: 0;
      display: block;
      width: max-content;
      max-width: 15rem;
      padding: 0.4rem 0.65rem;
      border: var(--borda);
      border-radius: var(--raio-s);
      background: var(--card-padrao-fundo);
      box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
      color: var(--cor-texto);
      font-size: var(--passo--1);
      font-weight: var(--peso-negrito);
    }
  }

  .mentoria-pagina__eixo-numero {
    color: var(--icone-cor);
    font-size: var(--passo--1);
  }

  .mentoria-pagina svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mentoria-pagina__inscricao {
    gap: var(--espaco-s);
  }

  .mentoria-pagina__inscricao > :global(.pilula) {
    align-self: flex-start;
  }

  .mentoria-pagina__encerrada {
    font-weight: var(--peso-negrito);
  }

  .mentoria-pagina__datas {
    display: grid;
    gap: var(--espaco-xs);
  }

  .mentoria-pagina__datas dt {
    color: var(--_texto-suave);
    font-size: var(--passo--1);
  }

  .mentoria-pagina__datas dd {
    margin: 0;
    font-size: var(--passo-1);
    font-weight: var(--peso-negrito);
  }

  .mentoria-pagina__inscrever {
    width: 100%;
  }

  .mentoria-pagina__nota {
    color: var(--_texto-suave);
    font-size: var(--passo--1);
  }

  .mentoria-pagina__nota--destaque {
    color: var(--_texto);
    font-size: var(--passo-0);
    font-weight: var(--peso-negrito);
  }

  /* ---- Texto do objetivo (Markdown do painel) ---- */
  .prosa :global(> * + *) {
    margin-block-start: var(--espaco-s);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    padding-inline-start: 1.25em;
  }

  .mentoria-pagina__lista {
    display: grid;
    gap: var(--espaco-s);
  }

  .mentoria-pagina__lista dt {
    color: var(--cor-texto-suave);
    font-size: var(--passo--1);
    font-weight: var(--peso-negrito);
  }

  .mentoria-pagina__lista dd {
    margin: 0;
  }

  .mentoria-pagina__lista ul {
    padding-inline-start: 1.25em;
  }

  /* ---- Mentores: foto redonda e mini currículo ---- */
  .mentoria-pagina__mentores {
    display: grid;
    gap: var(--espaco-m);
  }

  .bento__parceiro :global(img) {
    width: auto;
    max-width: 14rem;
    height: 3rem;
    object-fit: contain;
  }
</style>

<style>
  /* ---- Blocos (estilo "bento" do Railway) ----
   * Desktop: capa e inscrição no topo; mentores ao lado de eixos e parceiro; objetivo e público
   * lado a lado na última linha. Abaixo de 64rem: capa, inscrição (a ação da página: "Inscrever-se"
   * ou "Acessar a turma", na mesma ordem do HTML e do Tab), portal (se aberto), eixos, mentores,
   * parceiro, objetivo e público. Sem parceiro, o público ocupa o espaço dele. */
  .bento {
    display: grid;
    gap: var(--espaco-s);
    grid-template-areas: 'capa' 'inscricao' 'eixos' 'mentores' 'parceiro' 'objetivo' 'publico';
  }

  .bento[data-sem-parceiro] {
    grid-template-areas: 'capa' 'inscricao' 'eixos' 'mentores' 'objetivo' 'publico';
  }

  /* Portal aberto (depois do login): conteúdo da turma logo abaixo do card de inscrição (opção B).
   * A linha só existe com o portal visível, para não sobrar um espaço vazio na grade. */
  .bento:has(> .portal:not([hidden])) {
    grid-template-areas: 'capa' 'inscricao' 'portal' 'eixos' 'mentores' 'parceiro' 'objetivo' 'publico';
  }

  .bento[data-sem-parceiro]:has(> .portal:not([hidden])) {
    grid-template-areas: 'capa' 'inscricao' 'portal' 'eixos' 'mentores' 'objetivo' 'publico';
  }

  @media (width >= 64rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        'capa capa capa capa capa capa capa capa inscricao inscricao inscricao inscricao'
        'mentores mentores mentores mentores mentores eixos eixos eixos inscricao inscricao inscricao inscricao'
        'mentores mentores mentores mentores mentores parceiro parceiro parceiro parceiro parceiro parceiro parceiro'
        'objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo publico publico publico publico';
      align-items: stretch;
    }

    .bento[data-sem-parceiro] {
      grid-template-areas:
        'capa capa capa capa capa capa capa capa inscricao inscricao inscricao inscricao'
        'mentores mentores mentores mentores mentores eixos eixos eixos inscricao inscricao inscricao inscricao'
        'objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo publico publico publico publico';
    }

    .bento:has(> .portal:not([hidden])) {
      grid-template-areas:
        'capa capa capa capa capa capa capa capa inscricao inscricao inscricao inscricao'
        'portal portal portal portal portal portal portal portal portal portal portal portal'
        'mentores mentores mentores mentores mentores eixos eixos eixos parceiro parceiro parceiro parceiro'
        'objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo publico publico publico publico';
    }

    .bento[data-sem-parceiro]:has(> .portal:not([hidden])) {
      grid-template-areas:
        'capa capa capa capa capa capa capa capa inscricao inscricao inscricao inscricao'
        'portal portal portal portal portal portal portal portal portal portal portal portal'
        'mentores mentores mentores mentores mentores eixos eixos eixos publico publico publico publico'
        'objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo objetivo';
    }
  }

  /* Texto na largura toda dos blocos (sem a linha de leitura de 65ch do base.css). */
  .bento :global(:is(p, li)),
  .turma :global(:is(p, li)) {
    max-width: none;
  }

  .bento__capa { grid-area: capa; padding: 0; overflow: hidden; gap: 0; }
  .bento__inscricao { grid-area: inscricao; }
  .bento__objetivo { grid-area: objetivo; }
  .bento__eixos { grid-area: eixos; }
  .bento__publico { grid-area: publico; }
  .bento__mentores { grid-area: mentores; }
  .bento__parceiro { grid-area: parceiro; }
  /* PortalTurma.astro: a classe é do componente, por isso :global. */
  .bento > :global(.portal) { grid-area: portal; }
  .bento > :global(.portal[hidden]) { display: none; }

  .bento__bloco { gap: var(--espaco-xs); }

  .bento .mentoria-pagina__banner {
    aspect-ratio: 21 / 9;
    border: 0;
    border-radius: 0;
