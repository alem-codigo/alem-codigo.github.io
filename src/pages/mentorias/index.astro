---
/**
 * Listagem de mentorias (/mentorias) em três seções:
 * - Mentorias ativas: inscrições abertas e em breve (sem nenhuma, uma caixa oferece o aviso de novas turmas);
 * - Mentorias em andamento: inscrições encerradas e turmas acontecendo;
 * - Mentorias já realizadas: encerradas, da mais recente para a mais antiga, no mosaico que rola para
 *   o lado (GaleriaEncerradas), sem pílula (D-17).
 * Nos cards das duas primeiras, a pílula mostra a situação exata.
 *
 * Filtros por situação, eixo e parceria com JavaScript, refletidos na URL (`?status=…&eixo=…&parceria=…`),
 * para o botão "Inscrições abertas" do cabeçalho chegar já filtrado e o link poder ser compartilhado.
 * Sem JavaScript, os filtros não aparecem e a página mostra todas as mentorias.
 */
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import { getCollection } from 'astro:content';
import AvisoTurma from '../../components/AvisoTurma.astro';
import GaleriaEncerradas from '../../components/GaleriaEncerradas.astro';
import MentoriaCard from '../../components/MentoriaCard.astro';
import Base from '../../layouts/Base.astro';
import { hojeEmSaoPaulo } from '../../lib/datas';
import { listagemMentorias, opcoesParceria, slugParceiro } from '../../lib/mentorias';
import { FORM_AVISO, NEWSLETTER } from '../../lib/site';
import { ROTULO_STATUS, STATUS_COM_PILULA } from '../../lib/status';

const hoje = hojeEmSaoPaulo();
const mentorias = await getCollection('mentorias');
const eixos = (await getCollection('eixos')).sort((a, b) => a.data.ordem - b.data.ordem);
const { ativas, encerradas } = listagemMentorias(
  mentorias.map((entrada) => ({ ...entrada.data, entrada })),
  hoje,
);

// Só oferece no filtro as situações, os eixos e os parceiros que têm alguma mentoria.
const statusPresentes = STATUS_COM_PILULA.filter((s) => ativas.some((a) => a.status === s));
const idsEixos = (m: (typeof ativas)[number]['mentoria']) => m.eixos.map((e) => e.id);
const eixosPresentes = eixos.filter((e) => [...ativas, ...encerradas].some((a) => idsEixos(a.mentoria).includes(e.id)));
const parceria = (m: (typeof ativas)[number]['mentoria']) => (m.parceiro ? slugParceiro(m.parceiro.nome) : '');
const opcoesDeParceria = opcoesParceria([...ativas, ...encerradas].map((a) => a.mentoria.parceiro?.nome));
const temFiltros = ativas.length + encerradas.length > 1;

/** Ativas (abertas e em breve) e em andamento (inscrições encerradas ou turma acontecendo). */
const comInscricao = ativas.filter((a) => a.status === 'inscricoes-abertas' || a.status === 'em-breve');
const emAndamento = ativas.filter((a) => a.status === 'em-andamento' || a.status === 'inscricoes-encerradas');
const semInscricoes = comInscricao.length === 0;
const grupos = [
  { id: 'ativas', titulo: 'Mentorias ativas', itens: comInscricao },
  { id: 'andamento', titulo: 'Mentorias em andamento', itens: emAndamento },
].filter((g) => g.itens.length > 0 || g.id === 'ativas');
---

<Base
  title="Mentorias"
  description="Todas as mentorias do Além do Código: inscrições abertas, próximas turmas, turmas em andamento e mentorias encerradas."
>
  <div class="container listagem">
    <CabecalhoPagina rotulo="Mentorias" titulo="Conheça as mentorias" />

    {
      temFiltros && (
        <form class="filtros" data-filtros aria-label="Filtrar mentorias">
          {statusPresentes.length > 1 && (
            <fieldset class="filtros__grupo">
              <legend class="filtros__legenda">Situação</legend>
              <div class="filtros__opcoes">
                <label class="filtro">
                  <input type="radio" name="status" value="" checked />
                  <span>Todas</span>
                </label>
                {statusPresentes.map((s) => (
                  <label class="filtro">
                    <input type="radio" name="status" value={s} />
                    <span>{ROTULO_STATUS[s]}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}
          {eixosPresentes.length > 1 && (
            <div class="filtros__grupo">
              <label class="filtros__legenda" for="filtro-eixo">
                Eixo
              </label>
              <select class="filtros__select" id="filtro-eixo" name="eixo">
                <option value="">Todos os eixos</option>
                {eixosPresentes.map((e) => (
                  <option value={e.id}>
                    Eixo {e.data.numero} · {e.data.titulo}
                  </option>
                ))}
              </select>
            </div>
          )}
          {opcoesDeParceria.length > 0 && (
            <div class="filtros__grupo">
              <label class="filtros__legenda" for="filtro-parceria">
                Parceria
              </label>
              <select class="filtros__select" id="filtro-parceria" name="parceria">
                <option value="">Com e sem parceria</option>
                {opcoesDeParceria.map((o) => (
                  <option value={o.valor}>{o.rotulo}</option>
                ))}
              </select>
            </div>
          )}
          <div class="filtros__resultado">
            <p class="texto-suave" role="status" aria-live="polite" data-contagem />
            <button class="filtros__limpar" type="reset" data-limpar hidden>
              Limpar filtros
            </button>
          </div>
        </form>
      )
    }

    {
      grupos.map(({ id, titulo, itens }) => (
        <section class="listagem__grupo" aria-labelledby={`grupo-${id}`} data-grupo>
          <h2 class="listagem__titulo" id={`grupo-${id}`}>
            {titulo}
          </h2>
          {id === 'ativas' && semInscricoes && (
            <div class="informativo" role="note">
              <svg class="informativo__icone" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 16v-4M12 8h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
              </svg>
              <div class="informativo__texto">
                <p class="informativo__titulo">No momento, não há mentorias com inscrições abertas ou previstas.</p>
                {FORM_AVISO ? (
                  <details class="informativo__aviso">
                    <summary>Clique aqui para ser avisado de novas mentorias.</summary>
                    <AvisoTurma
                      mentoria="Novas mentorias (qualquer)"
                      situacao="Sem inscrições abertas"
                      titulo=""
                      texto="Deixe seu e-mail e avisamos quando abrir uma nova mentoria."
                    />
                  </details>
                ) : (
                  <p>
                    Novas turmas abrem ao longo do semestre.{' '}
                    <a href={NEWSLETTER}>Clique aqui para ser avisado de novas mentorias</a> pela nossa newsletter.
                  </p>
                )}
              </div>
            </div>
          )}
          {itens.length > 0 && (
            <ul class="grade listagem__grade" role="list">
              {itens.map(({ mentoria, status }) => (
                <li
                  data-item
                  data-status={status}
                  data-eixos={idsEixos(mentoria).join(' ')}
                  data-parceria={parceria(mentoria)}
                >
                  <MentoriaCard mentoria={mentoria.entrada} status={status} hoje={hoje} />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
    <div class="listagem__vazio" data-vazio-filtro hidden>
      <p class="listagem__vazio-titulo">Nenhuma turma ativa ou em andamento com esses filtros</p>
      <p class="texto-suave">Tente outra combinação de filtros.</p>
    </div>

  </div>

  {
    encerradas.length > 0 && (
      <section class="encerradas" id="encerradas" aria-labelledby="encerradas-titulo" data-secao="encerradas">
        <GaleriaEncerradas
          rotuloId="encerradas-titulo"
          itens={encerradas.map(({ mentoria }) => ({
            entrada: mentoria.entrada,
            eixos: idsEixos(mentoria).join(' '),
            parceria: parceria(mentoria),
          }))}
        >
          <Fragment slot="cabecalho">
            <h2 class="listagem__titulo" id="encerradas-titulo">
              Mentorias já realizadas
            </h2>
          </Fragment>
        </GaleriaEncerradas>
      </section>
    )
  }
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filtros]');

  if (form) {
    const itens = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];
    const encerradas = document.querySelector<HTMLElement>('[data-secao="encerradas"]');
    const contagem = form.querySelector<HTMLElement>('[data-contagem]')!;
    const limpar = form.querySelector<HTMLButtonElement>('[data-limpar]')!;
    const vazioFiltro = document.querySelector<HTMLElement>('[data-vazio-filtro]');

    const valor = (nome: string): string => {
      const campo = form.elements.namedItem(nome);
      if (campo instanceof RadioNodeList || campo instanceof HTMLSelectElement) return campo.value;
      return '';
    };

    const FILTROS = ['status', 'eixo', 'parceria'] as const;

    // Só aceita da URL valores que existem nos filtros (ignora valores desconhecidos).
    const aplicarDaUrl = () => {
      const params = new URLSearchParams(location.search);
      const status = params.get('status') ?? '';
      const radio = form.querySelector<HTMLInputElement>(`input[name="status"][value="${CSS.escape(status)}"]`);
      if (radio) radio.checked = true;
      for (const nome of ['eixo', 'parceria']) {
        const select = form.querySelector<HTMLSelectElement>(`select[name="${nome}"]`);
        const v = params.get(nome) ?? '';
        if (select && [...select.options].some((o) => o.value === v)) select.value = v;
      }
    };

    const passaParceria = (item: HTMLElement, filtro: string): boolean => {
      const p = item.dataset.parceria ?? '';
      if (!filtro) return true;
      return filtro === 'qualquer' ? p !== '' : p === filtro;
    };

    const filtrar = () => {
      const status = valor('status');
      const eixo = valor('eixo');
      const parceria = valor('parceria');
      let visiveis = 0;

      for (const item of itens) {
        const passaStatus = !status || item.dataset.status === status;
        const passaEixo = !eixo || (item.dataset.eixos ?? '').split(' ').includes(eixo);
        item.hidden = !(passaStatus && passaEixo && passaParceria(item, parceria));
        if (!item.hidden) visiveis++;
      }

      // Seção com cards e nenhum visível some (a de ativas sem turmas fica, com a caixa de aviso).
      let ativosVisiveis = 0;
      let ativosTotal = 0;
      for (const grupo of grupos) {
        const doGrupo = [...grupo.querySelectorAll<HTMLElement>('[data-item]')];
        const vis = doGrupo.filter((i) => !i.hidden).length;
        grupo.hidden = doGrupo.length > 0 && vis === 0;
        ativosVisiveis += vis;
        ativosTotal += doGrupo.length;
      }
      if (vazioFiltro) vazioFiltro.hidden = ativosVisiveis > 0 || ativosTotal === 0;
      if (encerradas) encerradas.hidden = ![...encerradas.querySelectorAll<HTMLElement>('[data-item]')].some((i) => !i.hidden);

      const filtrando = Boolean(status || eixo || parceria);
      limpar.hidden = !filtrando;
      contagem.textContent = filtrando
        ? `${visiveis} ${visiveis === 1 ? 'mentoria encontrada' : 'mentorias encontradas'}`
        : `${itens.length} ${itens.length === 1 ? 'mentoria' : 'mentorias'}`;

      const params = new URLSearchParams();
      for (const nome of FILTROS) {
        const v = valor(nome);
        if (v) params.set(nome, v);
      }
      const busca = params.toString();
      history.replaceState(null, '', busca ? `?${busca}${location.hash}` : location.pathname + location.hash);
      // A galeria de encerradas remonta a rolagem com os itens visíveis.
      document.dispatchEvent(new CustomEvent('listagem:filtrada'));
    };

    form.addEventListener('change', filtrar);
    form.addEventListener('submit', (e) => e.preventDefault());
    // O reset do formulário volta aos valores iniciais; filtra depois que o navegador os aplica.
    form.addEventListener('reset', () => requestAnimationFrame(filtrar));
    aplicarDaUrl();
    filtrar();
  }
</script>

<style>
  .listagem {
    display: flex;
    flex-direction: column;
    gap: var(--espaco-xl);
    padding-block: var(--espaco-xl) var(--espaco-2xl);
  }


  /* ---- Seções: ativas e em andamento ---- */
  .listagem__grupo {
    display: grid;
    gap: var(--espaco-m);
  }

  .listagem__grupo[hidden] {
    display: none;
  }

  .listagem__titulo {
    font-size: var(--passo-2);
  }

  /* Até 3 cards por linha, como na home. */
  .listagem__grade {
    --grade-min: max(18rem, calc((100% - 2 * var(--espaco-m)) / 3));
  }

  .listagem__grade > li {
    display: grid;
  }

  .listagem__grade > li[hidden],
  .encerradas[hidden] {
    display: none;
  }

  /* Encerradas: faixa de ponta a ponta, para o mosaico rolar até as bordas da tela. */
  .encerradas {
    padding-block: var(--espaco-xl) var(--espaco-2xl);
    border-block-start: var(--borda);
    background: var(--cor-faixa);
  }

  .listagem__vazio {
    display: grid;
    gap: var(--espaco-2xs);
    padding: var(--espaco-l);
    border: 1px dashed var(--cor-borda);
    border-radius: var(--raio-l);
  }

  .listagem__vazio[hidden] {
    display: none;
  }

  /* ---- Caixa de informação: sem inscrições abertas nem turmas previstas ---- */
  .informativo {
    display: flex;
    align-items: flex-start;
    gap: var(--espaco-s);
    padding: var(--espaco-m);
    border: 1px solid color-mix(in srgb, var(--cor-link) 45%, var(--cor-borda));
    border-radius: var(--raio-l);
    background: var(--card-violeta-fundo);
    color: var(--card-violeta-texto);
  }

  .informativo__icone {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.1em;
    color: var(--cor-link);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .informativo__texto {
    display: grid;
    gap: var(--espaco-2xs);
  }

  .informativo__titulo {
    font-size: var(--passo-1);
    font-weight: var(--peso-negrito);
  }

  .informativo a,
  .informativo summary {
    color: var(--card-violeta-link);
    font-weight: var(--peso-negrito);
  }

  .informativo summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    width: fit-content;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
    list-style: none;
  }

  .informativo summary::-webkit-details-marker {
    display: none;
  }

  .informativo__aviso[open] summary {
    margin-block-end: var(--espaco-2xs);
  }

  .listagem__vazio-titulo {
    font-size: var(--passo-1);
    font-weight: var(--peso-negrito);
  }

  /* ---- Filtros: só com JavaScript (sem ele, a página mostra todas) ---- */
  .filtros {
    display: none;
  }

  :global(.js) .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--espaco-s) var(--espaco-l);
  }

  /* Sem gap: a <legend> não participa do grid; a margem alinha os dois rótulos. */
  .filtros__grupo {
    display: grid;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filtros__legenda {
    padding: 0;
    margin-block-end: var(--espaco-2xs);
    color: var(--cor-texto-suave);
    font-family: var(--fonte-mono);
    font-size: var(--passo--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .filtros__opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3xs);
  }

  /* Opção de situação: rádio nativo escondido, rótulo em forma de pílula com alvo de 44px. */
  .filtro {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--espaco-s);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-pilula);
    background: var(--card-padrao-fundo);
    color: var(--cor-texto);
    font-size: var(--passo--1);
    font-weight: var(--peso-negrito);
    cursor: pointer;
    transition: border-color var(--duracao) var(--curva);
  }

  .filtro:hover {
    border-color: var(--cor-link);
  }

  .filtro input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filtro:has(input:checked) {
    border-color: var(--botao-fundo);
    background: var(--botao-fundo);
    color: var(--botao-texto);
  }

  .filtro:has(input:focus-visible) {
    outline: 3px solid var(--cor-foco);
    outline-offset: 2px;
  }

  .filtros__select {
    min-height: 2.75rem;
    max-width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-m);
    background: var(--card-padrao-fundo);
    color: var(--cor-texto);
    font: inherit;
    font-size: var(--passo--1);
  }

  .filtros__resultado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-2xs) var(--espaco-s);
    min-height: 2.75rem;
    margin-inline-start: auto;
    font-size: var(--passo--1);
  }

  .filtros__limpar {
    min-height: 2.75rem;
    padding: 0 var(--espaco-2xs);
    border: 0;
    background: none;
    color: var(--cor-link);
    font: inherit;
    font-weight: var(--peso-negrito);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .filtros__limpar[hidden] {
    display: none;
  }

  @media (width < 48rem) {
    .filtros__resultado {
      margin-inline-start: 0;
    }
  }
</style>
